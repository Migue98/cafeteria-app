# Valores exclusivos del entorno local. No reutilizar en producción.
POSTGRES_DB=cafeteria
POSTGRES_USER=cafeteria
POSTGRES_PASSWORD=cafeteria
APP_VERSION=local
OTEL_TRACES_EXPORTER=none
# console muestra spans JSON. compose.telemetry.yaml activa otlp hacia Alloy automáticamente.
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TIMEOUT=10
OTEL_BSP_SCHEDULE_DELAY=5000
OTEL_TRACES_SAMPLER=parentbased_always_on
HTTP_TIMEOUT_SECONDS=3
LOYALTY_RETRY_ENABLED=true
LOYALTY_RETRY_INTERVAL_SECONDS=900
LOYALTY_RETRY_BATCH_SIZE=100
FRONTEND_PORT=8000
MENU_PORT=8001
ORDERS_PORT=8002
LOYALTY_PORT=8003
# Solo se usan al añadir compose.monitoring.yaml; las interfaces se ligan a localhost.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-grafana-change-me
# Alertas locales: el worker de puntos se ejecuta cada 15 min; la espera es mayor.
ALERT_SERVICE_DOWN_FOR=30s
ALERT_HTTP_ERRORS_FOR=30s
ALERT_LOYALTY_PENDING_FOR=20m
# Solo con compose.telegram.yaml. No publiques los valores reales.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Solo se usan con compose.telemetry.yaml; OTLP permanece en la red interna.
LOKI_PORT=3100
TEMPO_PORT=3200
ALLOY_PORT=12345
DOCKER_SOCKET_PATH=/var/run/docker.sock
SESSION_SECRET=local-development-only-change-me
SESSION_HTTPS_ONLY=false
APP_ENV=development
PUBLIC_ORIGIN=
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
SESSION_MAX_AGE_SECONDS=86400

# Producción: APP_ENV=production, SESSION_HTTPS_ONLY=true, PUBLIC_ORIGIN=https://tu-dominio
# ALLOWED_HOSTS=tu-dominio,localhost,127.0.0.1 y SESSION_SECRET aleatorio (mínimo 32 caracteres).
# Todas las réplicas deben compartir SESSION_SECRET. No publiques archivos con secretos reales.
