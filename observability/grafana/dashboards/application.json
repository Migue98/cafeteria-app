{
  "uid": "cafeteria-application",
  "title": "Cafetería · aplicación",
  "description": "Tráfico, errores y latencia de los cuatro servicios. Las sondas quedan excluidas.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": [
    "cafeteria",
    "local"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Conexión",
      "url": "/d/cafeteria-metrics-connection",
      "type": "link"
    },
    {
      "title": "Aplicación",
      "url": "/d/cafeteria-application",
      "type": "link"
    },
    {
      "title": "Negocio",
      "url": "/d/cafeteria-business",
      "type": "link"
    },
    {
      "title": "Alertas",
      "url": "/alerting/list",
      "type": "link"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Disponibilidad por servicio",
      "description": "Disponibilidad de /metrics; no comprueba la salud de las dependencias.",
      "datasource": {
        "type": "prometheus",
        "uid": "cafeteria-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cafeteria-prometheus"
          },
          "expr": "up{job=\"cafeteria\"}",
          "legendFormat": "{{service}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Peticiones por segundo",
      "description": "Excluye /health y /metrics para no contar las sondas.",
      "datasource": {
        "type": "prometheus",
        "uid": "cafeteria-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cafeteria-prometheus"
          },
          "expr": "sum by (service) (rate(http_requests_total{job=\"cafeteria\",route!~\"/health|/metrics\"}[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Errores 5xx por segundo",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "cafeteria-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cafeteria-prometheus"
          },
          "expr": "(sum by (service) (rate(http_requests_total{job=\"cafeteria\",route!~\"/health|/metrics\",status_code=~\"5..\"}[$__rate_interval])) or on(service) (0 * sum by (service) (rate(http_requests_total{job=\"cafeteria\",route!~\"/health|/metrics\"}[$__rate_interval]))))",
          "legendFormat": "{{service}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "axisSoftMax": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Respuestas 5xx (%)",
      "description": "Cero sin errores; vacío si el servicio todavía no ha atendido tráfico de aplicación.",
      "datasource": {
        "type": "prometheus",
        "uid": "cafeteria-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cafeteria-prometheus"
          },
          "expr": "100 * (sum by (service) (rate(http_requests_total{job=\"cafeteria\",route!~\"/health|/metrics\",status_code=~\"5..\"}[$__rate_interval])) or on(service) (0 * sum by (service) (rate(http_requests_total{job=\"cafeteria\",route!~\"/health|/metrics\"}[$__rate_interval])))) / clamp_min(sum by (service) (rate(http_requests_total{job=\"cafeteria\",route!~\"/health|/metrics\"}[$__rate_interval])), 0.000001)",
          "legendFormat": "{{service}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latencia promedio",
      "description": "Media de solicitudes de aplicación; vacía sin tráfico reciente.",
      "datasource": {
        "type": "prometheus",
        "uid": "cafeteria-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cafeteria-prometheus"
          },
          "expr": "sum by(service) (rate(http_request_duration_seconds_sum{job=\"cafeteria\",route!~\"/health|/metrics\"}[$__rate_interval])) / sum by(service) (rate(http_request_duration_seconds_count{job=\"cafeteria\",route!~\"/health|/metrics\"}[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latencia p95",
      "description": "Estimación por buckets del histograma; vacía sin tráfico reciente.",
      "datasource": {
        "type": "prometheus",
        "uid": "cafeteria-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cafeteria-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by(le,service) (rate(http_request_duration_seconds_bucket{job=\"cafeteria\",route!~\"/health|/metrics\"}[$__rate_interval])))",
          "legendFormat": "{{service}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Respuestas por estado HTTP",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "cafeteria-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cafeteria-prometheus"
          },
          "expr": "sum by(service,status_code) (rate(http_requests_total{job=\"cafeteria\",route!~\"/health|/metrics\"}[$__rate_interval]))",
