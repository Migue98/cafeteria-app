      "id": 1,
      "type": "stat",
      "title": "Pedidos · proceso",
      "description": "Contador desde el arranque del proceso; no es un total histórico de la base de datos.",
      "datasource": {
        "type": "prometheus",
        "uid": "cafeteria-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cafeteria-prometheus"
          },
          "expr": "sum(cafe_orders_total{job=\"cafeteria\",status=\"confirmed\"}) or vector(0)",
          "legendFormat": "{{service}}",
          "instant": true,
          "range": false
