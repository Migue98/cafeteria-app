{
  "uid": "cafeteria-metrics-connection",
  "title": "Conexión de métricas",
  "description": "Comprueba que Prometheus puede leer /metrics en los cuatro servicios. UP mide el scrape; la salud de dependencias se consulta en /health.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": [
    "cafeteria",
    "local",
    "conexion"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "cafeteria-prometheus"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "id": 1,
      "title": "Servicios con métricas",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cafeteria-prometheus"
          },
          "expr": "count(up{job=\"cafeteria\"} == 1) or vector(0)",
          "legendFormat": "Servicios",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0,
          "max": 4,
          "mappings": [
            {
              "type": "value",
              "options": {
                "4": {
                  "text": "4 / 4",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 4
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "cafeteria-prometheus"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "id": 2,
      "title": "Conexión por servicio",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 18,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cafeteria-prometheus"
          },
          "expr": "up{job=\"cafeteria\"}",
          "legendFormat": "{{service}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    }
  ]
}
